{
  "manifest_version": 3,
  "name": "GTA 6 Spoiler Blocker",
  "version": "0.4.0",
  "description": "Hides GTA-related headlines, news cards and their images on web pages to avoid GTA 6 spoilers.",
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
